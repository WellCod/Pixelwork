# TLS automático pelo Let's Encrypt para os dois domínios.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Phaser desenha em canvas e carrega texturas por blob:; o LiveKit conecta no domínio dele.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://{$LIVEKIT_DOMAIN} https://{$LIVEKIT_DOMAIN}; frame-ancestors 'none'; base-uri 'self'"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
		-Server
	}

	# Rotas da API e o WebSocket vão para o app; o resto é o cliente estático (SPA).
	@api path /health /auth/* /me /me/* /spaces /spaces/* /orgs /orgs/* /invites /invites/* /templates /ws
	handle @api {
		reverse_proxy app:3000
	}

	handle {
		root * /srv
		# Arquivos com hash no nome (saída do Vite) nunca mudam; o index.html sempre revalida.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Sinalização do LiveKit (WebSocket) com TLS; a mídia vai direto por UDP/TCP no host.
{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}
