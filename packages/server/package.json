{
  "name": "@pixelwork/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@pixelwork/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "livekit-server-sdk": "2.20.0",
    "pg": "8.23.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11"
  }
}
