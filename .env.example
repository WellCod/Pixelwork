DATABASE_URL=postgres://app:app@localhost:5432/coworking
# Origem do app; usada na checagem de Origin
PUBLIC_URL=http://localhost:5173
# Porta do servidor; o Vite repassa as rotas da API para ela
PORT=3000
LIVEKIT_URL=ws://localhost:7880
# Chave e segredo do modo --dev do LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Login pelo GitHub (opcional; vazio esconde o botão). Crie um OAuth App em
# github.com/settings/developers com Homepage http://localhost:5173 e
# callback http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# false em dev local, true em produção
SESSION_COOKIE_SECURE=false
DEMO_SPACE_SLUG=demo
# true só atrás de proxy reverso (o compose de produção já define); afeta o limite de taxa por IP
TRUST_PROXY=false

# Outra pessoa na mesma rede (docs no README, "Testar com outra pessoa na rede"). Troque o IP pelo
# desta máquina e gere o certificado com o comando do README. Comentado = só esta máquina acessa.
# DEV_HOST=0.0.0.0
# DEV_HTTPS_CERT=.certs/dev.crt
# DEV_HTTPS_KEY=.certs/dev.key
# LIVEKIT_NODE_IP=192.168.0.10
# PUBLIC_URL=https://192.168.0.10:5173
# LIVEKIT_URL=wss://192.168.0.10:5173
# LIVEKIT_API_URL=http://localhost:7880

# Recepção de IA: requer também ativação pelo administrador de cada coworking.
# RECEPTIONIST_ENABLED=false
# RECEPTIONIST_PYTHON=/caminho/absoluto/para/python-com-livekit
# RECEPTIONIST_MAX_SESSIONS=2
# RECEPTIONIST_DURATION_SECONDS=120
