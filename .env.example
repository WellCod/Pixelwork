DATABASE_URL=postgres://app:app@localhost:5432/coworking
# Origem do app; usada na checagem de Origin
PUBLIC_URL=http://localhost:5173
# Porta do servidor; o Vite repassa as rotas da API para ela
PORT=3000
LIVEKIT_URL=ws://localhost:7880
# Chave e segredo do modo --dev do LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# false em dev local, true em produção
SESSION_COOKIE_SECURE=false
DEMO_SPACE_SLUG=demo
