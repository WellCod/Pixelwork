# Copie para .env.production na VPS e preencha. Tudo que muda entre local e VPS vem daqui.
APP_DOMAIN=pixelwork.example.com
LIVEKIT_DOMAIN=livekit.pixelwork.example.com
PUBLIC_URL=https://pixelwork.example.com
# Só letras e números (entra crua na DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
# O navegador conecta no LiveKit por este endereço (TLS pelo Caddy).
LIVEKIT_URL=wss://livekit.pixelwork.example.com
# Gere com: docker run --rm livekit/livekit-server:v1.13.11 generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_COOKIE_SECURE=true
DEMO_SPACE_SLUG=demo
